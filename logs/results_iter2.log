def compute_corrected_Sp(du, r_scales):
    du_corrected = du * (r_scales**(1/3))
    Sp = np.zeros((6, du.shape[1]))
    for p in range(1, 7):
        Sp[p-1] = np.mean(np.abs(du_corrected)**p, axis=0)
    return Sp

def extract_zeta(r, Sp, max_idx=None):
    if max_idx is not None:
        r_fit = r[:max_idx]
        Sp_fit = Sp[:, :max_idx]
    else:
        r_fit = r
        Sp_fit = Sp
    log_r = np.log(r_fit)
    zetas = []
    errors = []
    for p in range(6):
        log_Sp = np.log(np.maximum(Sp_fit[p], 1e-15))
        slope, intercept = np.polyfit(log_r, log_Sp, 1)
        residuals = log_Sp - (slope * log_r + intercept)
        ss_res = np.sum(residuals**2)
        ss_tot = np.sum((log_r - np.mean(log_r))**2)
        if len(r_fit) > 2:
            err = np.sqrt(ss_res / (len(r_fit) - 2) / ss_tot)
        else:
            err = 0.0
        zetas.append(slope)
        errors.append(err)
    return np.array(zetas), np.array(errors)

